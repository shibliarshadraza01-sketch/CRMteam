# Qualify Learn CRM — backend environment variable template.
#
# Copy this file to backend/.env and fill in the real values for your
# local development environment. The real .env is gitignored and must
# NEVER be committed. This template contains PLACEHOLDERS ONLY.

# --- Django core ---
# Generate a unique random value for real use, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL database ---
DB_NAME=crm_db
DB_USER=crm_dev
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (SendGrid, via SMTP relay) ---
# Leave unset in development — emails print to the console instead.
# Required in production (config/settings/production.py fails fast without it).
DJANGO_SENDGRID_API_KEY=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@qualifylearn.example

# --- Production-only (config/settings/production.py fails fast without these) ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.example
# Shared cache for distributed rate limiting (login/refresh/expensive-op
# throttles) across every backend instance — see production.py.
REDIS_URL=redis://your-redis-host:6379/0

# --- Telephony (A1 Routes SIP) ---
# Leave unset to leave this feature provider-ready-but-unverified (no
# real account exists yet) — see apps/communications/providers/.
# WhatsApp Business API integration was removed (explicitly descoped by
# the project owner) and must not be reintroduced.
A1ROUTES_API_KEY=
A1ROUTES_API_URL=https://api.a1routes.com/v1
A1ROUTES_WEBHOOK_SECRET=
A1ROUTES_DEFAULT_FROM_NUMBER=

# --- Google Sheets lead import (optional) ---
# Leave unset to leave spreadsheet import integration-ready but inactive:
# the backend still builds, migrates, starts and serves; the import
# endpoint answers 503 "not configured" rather than faking a successful
# external call. See apps/crm/providers/google_sheets.py.
#
# GOOGLE_SHEETS_PROVIDER selects the adapter — leave unset for the real
# API client (the safe default: it fails closed without a key). Set it to
# "mock" ONLY for local development, together with GOOGLE_SHEETS_MOCK_ROWS
# (a JSON array of row objects), to exercise the
# source -> validate -> preview -> confirm pipeline without an account.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_API_URL=https://sheets.googleapis.com/v4/spreadsheets
GOOGLE_SHEETS_PROVIDER=
GOOGLE_SHEETS_MOCK_ROWS=

# --- Security-change verification (optional) ---
# Which verification method must pass before a security-sensitive setting
# (username / password / Super Admin access code) is saved. Unset uses the
# built-in "current_password" provider (re-present your current password).
# See apps/accounts/verification.py for how to register an OTP/email/
# auth-app provider later without touching any call site.
SECURITY_VERIFICATION_PROVIDER=

# --- Inbound email (customer replies -> CRM, privacy-preserving) ---
# Every outbound customer email carries a CRM-owned Reply-To address of
# the form <INBOUND_EMAIL_LOCAL_PART_PREFIX>+<token>@INBOUND_EMAIL_DOMAIN,
# so a customer's reply comes back to the CRM (identified by that opaque
# token) instead of to an employee mailbox — the employee never handles
# the customer's real address in either direction.
#
# Leave INBOUND_EMAIL_DOMAIN unset to disable inbound routing entirely:
# outbound email keeps working, no Reply-To header is added, and the
# inbound webhook rejects everything.
#
# INBOUND_EMAIL_WEBHOOK_SECRET is the HMAC-SHA256 key the mail provider
# signs each inbound POST body with (header: X-Inbound-Email-Signature).
# The webhook FAILS CLOSED when it is unset — never leave it blank in an
# environment where INBOUND_EMAIL_DOMAIN is configured.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_LOCAL_PART_PREFIX=reply
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Database backup automation (see BACKUP_AND_RECOVERY_GUIDE.md) ---
BACKUP_STORAGE_PROVIDER=
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_RETENTION_DAYS=30
# Set to "true" only if a reverse proxy/load balancer terminates TLS and
# forwards X-Forwarded-Proto — never enable without one actually in front.
DJANGO_BEHIND_PROXY=false
